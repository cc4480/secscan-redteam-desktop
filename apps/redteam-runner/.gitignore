# The runner builds in-place to dist/ (and dist-test/ for its test build). These
# are regenerated by `pnpm --filter @secscan/redteam-runner run build`, so only
# the source is committed.
dist/
dist-test/

# Runtime engagement state (registry, reports, PoC bundles) is created under
# `engagements/` while the engine runs; it is operator data, not source.
engagements/
