# secscan-redteam Windows desktop release settings.
# Read by apps/desktop/scripts/* before packaging validates the build.
#
# Identity is deliberately NOT com.deepseek.harness: this is a separate product
# built from DeepSeek's MIT-licensed source, and it must not be mistakable for
# a DeepSeek release. Same reasoning as the `-unsigned` artifact suffix in the
# dsh-desktop build.

DSH_DESKTOP_APP_ID=com.secscan.redteam
DSH_DESKTOP_AUTO_UPDATE_ENV=production

# Required even for unsigned/preparation builds. A reserved, non-resolving
# .invalid origin, so this build contacts no update service (mirrors the
# dsh-desktop build's updates.dsh-local.invalid policy).
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://updates.secscan-redteam.invalid

# Signing is intentionally absent: this is an unsigned local build. SmartScreen
# will warn on first run and enterprise code-integrity policy may block it.
# DSH_DESKTOP_WINDOWS_CER_FILE=
# DSH_DESKTOP_WINDOWS_SIGNTOOL=
# DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
# DSH_DESKTOP_WINDOWS_TOKEN_PIN=
