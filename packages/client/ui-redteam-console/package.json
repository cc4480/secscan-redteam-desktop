{
  "description": "RedTeam console surfaces inside the chat client: the right-Sidebar Watch tab (live engagement feed, fleet roster, the engagement's own stats, abort and autonomy-tier controls) over the host console-share routes",
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-dockkit": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@secscan/redteam-console-share": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@secscan/redteam-console-share"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./client": {
      "default": "./lib/client.js",
      "types": "./lib/types/client/index.d.ts"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "name": "@deepseek-ai/dsh-client-ui-redteam-console",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/client/ui-redteam-console",
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "version": "0.1.7-rc.9"
}
