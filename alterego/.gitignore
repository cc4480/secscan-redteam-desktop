# AlterEgo bridge -- generated and runtime content must never be committed.

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenv: rebuildable; contains absolute paths and ~85 MB of binaries
.venv/
venv/

# Chrome profiles driven by the browser tools (~820 MB, regenerated)
browser-profile/
browser-profile-fallback/

# Live runtime state: event log, jobs DB, session tokens, audit trail
data/

# Logs -- a live log makes the working tree permanently dirty
*.log
*.log.err

# Historical snapshots and local scratch
backup-*/
demo-evidence/
*.bak-*
*.bak
*.tgz
*.tar.gz
